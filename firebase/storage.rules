rules_version = '2';

// ChopCircle — Storage rules. Public read (food photos are the product),
// authenticated write, size- and type-limited to prevent abuse.

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function isValidImage() {
      return request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    // Chat voice notes (Phase 12) — same size ceiling as images, but audio/*
    // instead of image/*. Kept as its own function (rather than loosening
    // isValidImage's regex) so the users/recipes/posts photo paths below
    // stay image-only on purpose.
    function isValidChatMedia() {
      return request.resource.size < 8 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('audio/.*'));
    }
    // Recipe cook-along clip (one per recipe, `recipes/{recipeId}.videoURL`).
    // Meant to be a short, already-edited/fast-forwarded 20-30s clip, not a
    // raw phone recording, so the size ceiling is deliberately tight —
    // js/utils/videoUpload.js enforces the same limit plus a duration check
    // client-side first, this is just the server-side backstop.
    function isValidRecipeVideo() {
      return request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }

    match /users/{uid}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid && isValidImage();
    }

    match /recipes/{uid}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid && (isValidImage() || isValidRecipeVideo());
    }

    match /posts/{uid}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid && isValidImage();
    }

    match /chats/{chatId}/{fileName} {
      // Split (unlike the folders above) because isValidChatMedia() checks
      // request.resource, which only exists on a WRITE request — applying
      // it to reads too (as a single shared `allow read, write` condition
      // would) makes every read fail with a 403, since request.resource is
      // undefined there.
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidChatMedia();
      // Tightened once chat participant lookups are available in Storage rules
      // (requires a Firestore get() call — see chats rule in firestore.rules
      // for the pattern to mirror here).
    }
  }
}